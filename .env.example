# Bot Control Center — root environment template
# Copy to /etc/bot-control-center/bcc.env on the server and fill in real values.
# NEVER commit a real .env file.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://bcc_user:change_me@127.0.0.1:5432/bot_control_center

# --- Security -------------------------------------------------------------
SECRET_KEY=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=bcc_session
SESSION_TTL_MINUTES=720
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# --- CORS / web -----------------------------------------------------------
CORS_ORIGINS=https://bots.example.com

# --- Telegram Admin Bot ----------------------------------------------------
TELEGRAM_BOT_TOKEN=change_me
# Comma separated list of allowed Telegram numeric IDs
TELEGRAM_ADMIN_IDS=

# --- Monitoring -------------------------------------------------------------
# Default poll interval in seconds for services that don't override it
MONITOR_DEFAULT_INTERVAL_SECONDS=15
# Number of consecutive failed checks before an incident is confirmed
MONITOR_FAILURE_THRESHOLD=3
# Minimum seconds between repeat notifications for the same incident
NOTIFICATION_COOLDOWN_SECONDS=900

# --- Logs -------------------------------------------------------------------
# Max lines fetched per journalctl call
LOG_FETCH_LIMIT=500

# --- Data retention ----------------------------------------------------------
# Days of service_status_history/log_events/notification_deliveries/health_checks
# kept before the worker's daily cleanup job deletes them.
RETENTION_DAYS=30
