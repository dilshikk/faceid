[Unit]
Description=Bot Control Center API
After=network.target postgresql.service

[Service]
Type=simple
User=bcc
Group=bcc
# The API reads other services' logs via journalctl (log view). Without
# membership in systemd-journal journalctl silently returns nothing.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/bot-control-center/backend
EnvironmentFile=/etc/bot-control-center/bcc.env
# Port 8091: 8081 is already used by a Docker container on the VPS.
ExecStart=/opt/bot-control-center/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bot-control-center/backend
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
