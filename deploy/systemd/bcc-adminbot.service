[Unit]
Description=Bot Control Center Telegram Admin Bot
After=network.target

[Service]
Type=simple
User=bcc
Group=bcc
# /logs reads other services' logs via journalctl; this group is required.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/bot-control-center/backend
EnvironmentFile=/etc/bot-control-center/bcc.env
ExecStart=/opt/bot-control-center/backend/.venv/bin/python -m app.telegram_admin.main
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bot-control-center/backend

[Install]
WantedBy=multi-user.target
