[Unit]
Description=Bot Control Center Monitoring Worker
After=network.target postgresql.service

[Service]
Type=simple
User=bcc
Group=bcc
# Read-only `systemctl show` works for any user. `journalctl` only returns
# other services' logs for members of the systemd-journal group; without it
# the log view is silently empty.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/bot-control-center/backend
EnvironmentFile=/etc/bot-control-center/bcc.env
ExecStart=/opt/bot-control-center/backend/.venv/bin/python -m app.workers.monitor_worker
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bot-control-center/backend

[Install]
WantedBy=multi-user.target
